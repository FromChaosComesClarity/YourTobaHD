{
  "name": "yourtoba-hd",
  "productName": "YourTobaHD",
  "version": "0.1.0",
  "description": "Lightweight YouTube TV (Leanback) shell for modern 16:9 TVs, 1080p and 4K",
  "main": "main.js",
  "desktopName": "yourtobahd.desktop",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "41.3.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.5.0",
    "@ghostery/adblocker-electron": "^2.5.0"
  },
  "build": {
    "appId": "io.github.fromchaoscomesclarity.yourtobahd",
    "productName": "YourTobaHD",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "AudioVideo",
      "executableName": "yourtobahd",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "YourTobaHD.AppImage"
    },
    "files": [
      "main.js",
      "preload.js",
      "hd-style.css",
      "assets/**/*"
    ]
  }
}
